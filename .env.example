# TaskFlow Enterprise System Environment Configuration Template

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/taskflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=taskflow_user
DB_PASSWORD=your_secure_db_password_here

# MySQL Docker Container Configuration
MYSQL_DATABASE=taskflow_db
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# JWT Security Credentials
JWT_SECRET=your_base64_encoded_32_character_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Security Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
